SUPABASE_URL=https://your-project.supabase.co
# Server-side service role key. Never expose it in public files or browser code.
SUPABASE_SERVICE_KEY=
# PostgreSQL connection used only by the persistent session store.
DATABASE_URL=
PORT=9876
NODE_ENV=production
APP_ORIGIN=https://budget.example.com
SESSION_COOKIE_SECURE=true
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Comma-separated trusted proxy IPs/CIDRs; leave empty for direct connections.
TRUST_PROXY=
